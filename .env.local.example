# 前端环境变量 — 复制为 .env.local 后填写

# WalletConnect Cloud 项目 ID(免费申请,几十秒):https://cloud.walletconnect.com
# 不填也能跑,但 WalletConnect(手机扫码连接)会不可用,建议 demo 前配置好
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 合约部署到 Monad Testnet 后,把地址填在这里
NEXT_PUBLIC_CONTRACT_ADDRESS=

# --- 以下为审核后端(API routes)用的服务端变量,绝不能加 NEXT_PUBLIC_ 前缀 ---

# 用于签发 EIP-712 mint 授权的私钥,必须对应合约部署时写入的 ATTESTOR_ADDRESS
# (contracts/.env 里的同名变量),仅在服务端读取,切勿提交到 git
ATTESTOR_PRIVATE_KEY=

# 保护 /api/admin/* 接口的共享密钥,自己随便生成一串够长的随机字符串即可
ADMIN_SECRET=

# Upstash Redis(Vercel Marketplace 的 Redis 集成会自动注入这两个变量)
# 本地开发不填也能跑 —— 缺失时会自动降级为进程内内存存储(仅用于本地调试,重启即丢失)
KV_REST_API_URL=
KV_REST_API_TOKEN=
